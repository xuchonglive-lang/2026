{
  "bsonType": "object",
  "required": ["name", "biz_type"],
  "permission": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "_id": {
      "description": "ID"
    },
    "name": {
      "bsonType": "string",
      "title": "模板名称",
      "trim": "both"
    },
    "biz_type": {
      "bsonType": "string",
      "title": "业务类型",
      "description": "如system/training/work/info，动态扩展",
      "trim": "both"
    },
    "wx_template_id": {
      "bsonType": "string",
      "title": "微信模板消息ID"
    },
    "title_template": {
      "bsonType": "string",
      "title": "标题模板",
      "description": "支持{{变量名}}占位符"
    },
    "content_template": {
      "bsonType": "string",
      "title": "内容模板",
      "description": "支持{{变量名}}占位符"
    },
    "url_template": {
      "bsonType": "string",
      "title": "跳转URL模板",
      "description": "如/pages/training/video-detail?id={{course_id}}"
    },
    "status": {
      "bsonType": "int",
      "title": "状态",
      "description": "0=停用 1=启用",
      "defaultValue": 1,
      "enum": [0, 1]
    },
    "created_by": {
      "bsonType": "string",
      "title": "创建人"
    },
    "created_at": {
      "bsonType": "timestamp",
      "title": "创建时间"
    },
    "updated_by": {
      "bsonType": "string",
      "title": "更新人"
    },
    "updated_at": {
      "bsonType": "timestamp",
      "title": "更新时间"
    }
  }
}
