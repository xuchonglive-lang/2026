{
  "bsonType": "object",
  "required": ["name", "code", "dept_level", "status"],
  "permission": {
    "read": "auth.uid != null",
    "create": "'CREATE_XC_TENANTS' in auth.permission",
    "update": "'UPDATE_XC_TENANTS' in auth.permission",
    "delete": "'DELETE_XC_TENANTS' in auth.permission"
  },
  "properties": {
    "_id": {
      "description": "ID"
    },
    "name": {
      "bsonType": "string",
      "title": "部门名称",
      "trim": "both"
    },
    "code": {
      "bsonType": "string",
      "title": "部门编码",
      "trim": "both"
    },
    "parent_id": {
      "bsonType": "string",
      "title": "上级部门ID",
      "description": "集团级为null"
    },
    "dept_path": {
      "bsonType": "string",
      "title": "层级路径",
      "description": "格式: /集团ID/部门ID"
    },
    "dept_level": {
      "bsonType": "int",
      "title": "层级",
      "description": "0=集团 10=部室 20=车间",
      "enum": [0, 10, 20]
    },
    "leader_id": {
      "bsonType": "string",
      "title": "负责人用户ID"
    },
    "sort_num": {
      "bsonType": "int",
      "title": "排序号",
      "defaultValue": 0
    },
    "status": {
      "bsonType": "int",
      "title": "状态",
      "description": "0=停用 1=启用",
      "defaultValue": 1,
      "enum": [0, 1]
    },
    "description": {
      "bsonType": "string",
      "title": "简介"
    },
    "created_by": {
      "bsonType": "string",
      "title": "创建人"
    },
    "created_at": {
      "bsonType": "timestamp",
      "title": "创建时间"
    },
    "updated_by": {
      "bsonType": "string",
      "title": "更新人"
    },
    "updated_at": {
      "bsonType": "timestamp",
      "title": "更新时间"
    }
  }
}
