{
  "bsonType": "object",
  "required": ["tenant_id", "article_id", "content", "created_by"],
  "permission": {
    "read": "auth.uid != null",
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "_id": {
      "description": "ID"
    },
    "tenant_id": {
      "bsonType": "string",
      "title": "租户ID"
    },
    "article_id": {
      "bsonType": "string",
      "title": "关联文章ID",
      "description": "关联 xc-info-articles._id"
    },
    "parent_id": {
      "bsonType": "string",
      "title": "父评论ID",
      "description": "空=一级评论，非空=回复（两层扁平结构）"
    },
    "reply_to_uid": {
      "bsonType": "string",
      "title": "回复目标用户ID",
      "description": "回复时填充"
    },
    "reply_to_nickname": {
      "bsonType": "string",
      "title": "回复目标昵称",
      "description": "@昵称标识回复对象"
    },
    "content": {
      "bsonType": "string",
      "title": "评论内容",
      "trim": "both"
    },
    "is_deleted": {
      "bsonType": "bool",
      "title": "软删除标记",
      "description": "用户可删自己评论，管理员可删任何评论",
      "defaultValue": false
    },
    "created_by": {
      "bsonType": "string",
      "title": "评论人ID"
    },
    "created_at": {
      "bsonType": "timestamp",
      "title": "创建时间"
    }
  }
}
