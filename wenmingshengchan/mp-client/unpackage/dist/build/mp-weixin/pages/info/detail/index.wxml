<view class="app page-container industrial-grid data-v-1cc6a26b"><cu-custom vue-id="68e5324c-1" bgColor="bg-gradual-blue" isCustom="{{true}}" class="data-v-1cc6a26b" bind:__l="__l" vue-slots="{{['backText','content']}}"><view slot="backText" class="data-v-1cc6a26b"></view><view slot="content" class="data-v-1cc6a26b">信息详情</view></cu-custom><block wx:if="{{detail}}"><view class="main-content data-v-1cc6a26b"><view class="header-section data-v-1cc6a26b"><view class="tag-row data-v-1cc6a26b"><text class="category-tag text-secondary bg-secondary-light data-v-1cc6a26b">{{categoryName}}</text></view><text class="article-title data-v-1cc6a26b">{{detail.title}}</text><view class="title-underline data-v-1cc6a26b"></view><view class="article-meta data-v-1cc6a26b"><view class="meta-item data-v-1cc6a26b"><u-icon style="margin-right:8rpx;" vue-id="68e5324c-2" name="calendar" size="28" class="data-v-1cc6a26b" bind:__l="__l"></u-icon><text class="data-v-1cc6a26b">{{$root.g0}}</text></view><view class="meta-item views data-v-1cc6a26b"><u-icon style="margin-right:8rpx;" vue-id="68e5324c-3" name="eye" size="28" class="data-v-1cc6a26b" bind:__l="__l"></u-icon><text class="data-v-1cc6a26b">{{(detail.view_count||0)+" 阅读"}}</text></view></view></view><view class="glass-card article-content-card data-v-1cc6a26b"><rich-text nodes="{{formattedContent}}" class="data-v-1cc6a26b"></rich-text></view><block wx:if="{{$root.g1>0}}"><view class="glass-card read-logs-card data-v-1cc6a26b"><view class="logs-header data-v-1cc6a26b"><view class="title-wrapper data-v-1cc6a26b"><u-icon style="margin-right:8rpx;" vue-id="68e5324c-4" name="clock" size="36" color="#0050cb" class="data-v-1cc6a26b" bind:__l="__l"></u-icon><text class="title data-v-1cc6a26b">近期阅览足迹</text></view><text class="subtitle data-v-1cc6a26b">{{readTotal+"人已阅"}}</text></view><scroll-view class="logs-scroll data-v-1cc6a26b" scroll-x="{{true}}" show-scrollbar="{{false}}"><view class="logs-inner data-v-1cc6a26b"><block wx:for="{{$root.l0}}" wx:for-item="log" wx:for-index="idx" wx:key="idx"><view class="reader-item data-v-1cc6a26b"><image class="reader-avatar data-v-1cc6a26b" src="{{log.$orig.userInfo&&log.$orig.userInfo[0]&&log.$orig.userInfo[0].avatar?log.$orig.userInfo[0].avatar:'/static/default-avatar.png'}}" mode="aspectFill"></image><text class="reader-name u-line-2 data-v-1cc6a26b">{{log.$orig.userInfo&&log.$orig.userInfo[0]&&log.$orig.userInfo[0].real_name?log.$orig.userInfo[0].department_name+' '+log.$orig.userInfo[0].real_name:'匿名的矿工'}}</text><text class="reader-time data-v-1cc6a26b">{{log.g2}}</text></view></block></view></scroll-view></view></block></view></block><block wx:else><view class="loading-state data-v-1cc6a26b"><u-loading vue-id="68e5324c-5" size="60" color="#0050cb" mode="circle" class="data-v-1cc6a26b" bind:__l="__l"></u-loading></view></block></view>