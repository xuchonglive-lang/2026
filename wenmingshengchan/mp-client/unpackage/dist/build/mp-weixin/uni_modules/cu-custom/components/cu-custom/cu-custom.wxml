<view class="cu-custom data-v-409bef90" style="{{('height:'+CustomBar+'px;')}}"><view class="{{['data-v-409bef90','cu-bar fixed '+(bgImage!=''?' none-bg text-white bg-img ':'')+bgColor]}}" style="{{'width:100%;'+('height:'+CustomBar+'px;padding-top:'+StatusBar+'px;'+(bgImage?'background-image:url('+bgImage+')':''))}}"><block wx:if="{{$root.g0!=-1}}"><view class="wave-bg data-v-409bef90"></view></block><block wx:if="{{isBack}}"><view data-event-opts="{{[['tap',[['backPage',['$event']]]]]}}" class="action data-v-409bef90" bindtap="__e"><view class="icon-svg-back data-v-409bef90"></view><text class="data-v-409bef90">{{backText}}</text></view></block><block wx:if="{{isCustom}}"><view class="action border-custom data-v-409bef90" style="{{('width:'+Custom.width+'px;height:'+Custom.height+'px;margin-left:calc(750rpx - '+Custom.right+'px)')}}"><view data-event-opts="{{[['tap',[['backPage',['$event']]]]]}}" class="icon-svg-back data-v-409bef90" bindtap="__e"></view><view data-event-opts="{{[['tap',[['toHome',['$event']]]]]}}" class="icon-svg-home data-v-409bef90" bindtap="__e"></view></view></block><view class="content data-v-409bef90" style="{{('top:'+StatusBar+'px;')}}">{{''+title+''}}<slot name="title"></slot><slot name="content"></slot></view><view class="flex flex-wrap align-end data-v-409bef90" style="margin-right:150rpx;"><block wx:if="{{showScan}}"><view data-event-opts="{{[['tap',[['scan',['$event']]]]]}}" class="{{['margin-left-xs','cuIcon-scan','data-v-409bef90',scanBg]}}" style="font-size:50rpx;" bindtap="__e"></view></block></view></view></view>