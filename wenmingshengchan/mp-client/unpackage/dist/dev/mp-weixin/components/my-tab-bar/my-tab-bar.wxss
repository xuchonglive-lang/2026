.custom-tab-bar.data-v-414cfb84 {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100vw;
  height: 160rpx;
  /* 80px + padding for iphones */
  z-index: 999;
  /* Use absolute div for background to prevent blur inheritance issues */
}
.custom-tab-bar .tab-bg.data-v-414cfb84 {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 40rpx 40rpx 0 0;
  border-bottom: none;
  z-index: -1;
}
