<view class="account-close-page data-v-2a917c98"><view class="status-card data-v-2a917c98"><view class="status-header data-v-2a917c98"><view class="{{['status-icon','data-v-2a917c98',statusClass]}}"><text class="icon data-v-2a917c98">{{statusIcon}}</text></view><view class="status-info data-v-2a917c98"><text class="status-title data-v-2a917c98">{{statusTitle}}</text><text class="status-desc data-v-2a917c98">{{statusDesc}}</text></view></view><block wx:if="{{isInCoolingPeriod}}"><view class="countdown-section data-v-2a917c98"><view class="countdown-label data-v-2a917c98">冷静期剩余时间</view><view class="countdown-display data-v-2a917c98"><text class="countdown-time data-v-2a917c98">{{formattedDuration}}</text></view><view class="progress-bar data-v-2a917c98" style="{{'--progress-width:'+(progressWidth+'%')+';'}}"><view class="progress-fill data-v-2a917c98"></view></view></view></block></view><block wx:if="{{isLoad}}"><view class="action-section data-v-2a917c98"><block wx:if="{{!isInCoolingPeriod&&!isAccountClosed}}"><button class="{{['action-btn','warn-btn','data-v-2a917c98',(loading.close)?'disabled':'']}}" loading="{{loading.close}}" disabled="{{loading.close}}" data-event-opts="{{[['tap',[['applyCloseAccount',['$event']]]]]}}" bindtap="__e"><text class="btn-text data-v-2a917c98">申请注销账号</text></button></block><block wx:if="{{isInCoolingPeriod}}"><button class="{{['action-btn','success-btn','data-v-2a917c98',(loading.open)?'disabled':'']}}" loading="{{loading.open}}" disabled="{{loading.open}}" data-event-opts="{{[['tap',[['openAccount',['$event']]]]]}}" bindtap="__e"><text class="btn-text data-v-2a917c98">恢复账号</text></button></block><block wx:if="{{isInCoolingPeriod}}"><button class="{{['action-btn','outline-warn-btn','data-v-2a917c98',(loading.open||loading.confirm||duration>0)?'disabled':'']}}" loading="{{loading.confirm}}" disabled="{{loading.open||loading.confirm||duration>0}}" data-event-opts="{{[['tap',[['confirmCloseAccount',['$event']]]]]}}" bindtap="__e"><text class="btn-text data-v-2a917c98">确认注销</text></button></block></view></block><view class="tips-section data-v-2a917c98"><view class="tips-header data-v-2a917c98"><text class="tips-icon data-v-2a917c98">💡</text><text class="tips-title data-v-2a917c98">重要提示</text></view><view class="tips-content data-v-2a917c98"><text class="tips-item data-v-2a917c98">注销申请提交后有7天冷静期</text><text class="tips-item data-v-2a917c98">冷静期内可以随时恢复账号</text><text class="tips-item data-v-2a917c98">冷静期结束后需要确认才能完成注销</text><text class="tips-item data-v-2a917c98">账号确认注销后将无法恢复，请谨慎操作</text></view></view><block wx:if="{{showConfirmModal}}"><view data-event-opts="{{[['tap',[['closeModal',['$event']]]]]}}" class="modal-overlay data-v-2a917c98" bindtap="__e"><view data-event-opts="{{[['tap',[['',['$event']]]]]}}" class="modal-content data-v-2a917c98" catchtap="__e"><view class="modal-header data-v-2a917c98"><text class="modal-title data-v-2a917c98">确认注销账号</text><text data-event-opts="{{[['tap',[['closeModal',['$event']]]]]}}" class="modal-close data-v-2a917c98" bindtap="__e">×</text></view><view class="modal-body data-v-2a917c98"><text class="modal-warning data-v-2a917c98">此操作不可逆，请确认您真的要注销账号</text><view class="input-section data-v-2a917c98"><text class="input-label data-v-2a917c98">请输入"确认注销"以继续：</text><input class="confirm-input data-v-2a917c98" placeholder="请输入：确认注销" placeholder-class="input-placeholder-class" data-event-opts="{{[['input',[['__set_model',['','confirmText','$event',[]]]]]]}}" value="{{confirmText}}" bindinput="__e"/></view></view><view class="modal-footer data-v-2a917c98"><button data-event-opts="{{[['tap',[['closeModal',['$event']]]]]}}" class="modal-btn cancel-btn data-v-2a917c98" bindtap="__e">取消</button><button class="modal-btn danger-btn data-v-2a917c98" loading="{{loading.confirm}}" disabled="{{$root.g0}}" data-event-opts="{{[['tap',[['handleConfirmClose',['$event']]]]]}}" bindtap="__e"> 确认注销 </button></view></view></view></block><block wx:if="{{showSuccessPage}}"><view class="success-o