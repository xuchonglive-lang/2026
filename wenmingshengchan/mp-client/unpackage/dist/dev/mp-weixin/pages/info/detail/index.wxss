.page-container.data-v-17150fac {
  font-family: "Inter", sans-serif;
  background-color: #f7f9fb;
  min-height: 100vh;
  padding-bottom: 60rpx;
}
.industrial-grid.data-v-17150fac {
  background-image: radial-gradient(rgba(0, 80, 203, 0.05) 1px, transparent 1px);
  background-size: 48rpx 48rpx;
}
.main-content.data-v-17150fac {
  padding-top: calc(env(safe-area-inset-top) + 20rpx);
  padding-left: 30rpx;
  padding-right: 30rpx;
}
/* Header Section */
.header-section.data-v-17150fac {
  margin-bottom: 40rpx;
}
.header-section .tag-row.data-v-17150fac {
  margin-bottom: 24rpx;
}
.header-section .tag-row .category-tag.data-v-17150fac {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
}
.header-section .tag-row .category-tag.text-secondary.data-v-17150fac {
  color: #294487;
}
.header-section .tag-row .category-tag.bg-secondary-light.data-v-17150fac {
  background: rgba(155, 180, 254, 0.2);
}
.header-section .article-title.data-v-17150fac {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  color: #191c1e;
  line-height: 1.4;
  margin-bottom: 20rpx;
}
.header-section .title-underline.data-v-17150fac {
  width: 80rpx;
  height: 8rpx;
  background: linear-gradient(90deg, #0050cb 0%, #9bb4fe 100%);
