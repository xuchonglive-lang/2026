<view class="app page-container industrial-grid data-v-17150fac"><block wx:if="{{detail}}"><view class="main-content data-v-17150fac"><view class="header-section data-v-17150fac"><view class="tag-row data-v-17150fac"><text class="category-tag text-secondary bg-secondary-light data-v-17150fac">{{categoryName}}</text></view><text class="article-title data-v-17150fac">{{detail.title}}</text><view class="title-underline data-v-17150fac"></view><view class="article-meta data-v-17150fac"><view class="meta-item data-v-17150fac"><u-icon style="margin-right:8rpx;" vue-id="68e5324c-1" name="calendar" size="28" class="data-v-17150fac" bind:__l="__l"></u-icon><text class="data-v-17150fac">{{$root.g0}}</text></view><view class="meta-item views data-v-17150fac"><u-icon style="margin-right:8rpx;" vue-id="68e5324c-2" name="eye" size="28" class="data-v-17150fac" bind:__l="__l"></u-icon><text class="data-v-17150fac">{{(detail.view_count||0)+" 阅读"}}</text></view></view></view><view class="glass-card article-content-card data-v-17150fac"><rich-text nodes="{{formattedContent}}" class="data-v-17150fac"></rich-text></view><block wx:if="{{$root.g1>0}}"><view class="glass-card read-logs-card data-v-17150fac"><view class="logs-header data-v-17150fac"><view class="title-wrapper data-v-17150fac"><u-icon style="margin-right:8rpx;" vue-id="68e5324c-3" name="clock" size="36" color="#0050cb" class="data-v-17150fac" bind:__l="__l"></u-icon><text class="title data-v-17150fac">近期阅览足迹</text></view><text class="subtitle data-v-17150fac">{{readTotal+"人已阅"}}</text></view><scroll-view class="logs-scroll data-v-17150fac" scroll-x="{{true}}" show-scrollbar="{{false}}"><view class="logs-inner data-v-17150fac"><block wx:for="{{$root.l0}}" wx:for-item="log" wx:for-index="idx" wx:key="idx"><view class="reader-item data-v-17150fac"><image class="reader-avatar data-v-17150fac" src="{{log.$orig.userInfo&&log.$orig.userInfo[0]&&log.$orig.userInfo[0].avatar?log.$orig.userInfo[0].avatar:'/static/default-avatar.png'}}" mode="aspectFill"></image><text class="reader-name u-line-2 data-v-17150fac">{{log.$orig.userInfo&&log.$orig.userInfo[0]&&log.$orig.userInfo[0].real_name?log.$orig.userInfo[0].department_name+' '+log.$orig.userInfo[0].real_name:'匿名的矿工'}}</text><text class="reader-time data-v-17150fac">{{log.g2}}</text></view></block></view></scroll-view></view></block></view></block><block wx:else><view class="loading-state data-v-17150fac"><u-loading vue-id="68e5324c-4" size="60" color="#0050cb" mode="circle" class="data-v-17150fac" bind:__l="__l"></u-loading></view></block></view>