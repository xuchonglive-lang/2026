',[['e2',['$event']]]]]}}" data-event-params="{{({idx})}}" class="photo-del data-v-5fbfa8f6" bindtap="__e"><text class="material-symbols-outlined text-white data-v-5fbfa8f6" style="font-size:28rpx;">close</text></view></view></block><block wx:if="{{$root.g2<9}}"><view data-event-opts="{{[['tap',[['chooseImages',['$event']]]]]}}" class="photo-add rounded-lg flex center data-v-5fbfa8f6" bindtap="__e"><text class="material-symbols-outlined text-on-surface-variant data-v-5fbfa8f6" style="font-size:48rpx;">add_photo_alternate</text></view></block></view></view></view><view class="form-group data-v-5fbfa8f6"><text class="form-label text-on-surface-variant text-xs font-bold uppercase data-v-5fbfa8f6">备注说明</text><textarea class="form-textarea data-v-5fbfa8f6" placeholder="请输入完成情况说明..." maxlength="500" data-event-opts="{{[['input',[['__set_model',['','feedbackRemark','$event',[]]]]]]}}" value="{{feedbackRemark}}" bindinput="__e"></textarea></view><view class="modal-footer flex gap-3 data-v-5fbfa8f6"><view data-event-opts="{{[['tap',[['e3',['$event']]]]]}}" class="btn-cancel flex-1 flex center h-14 rounded-2xl data-v-5fbfa8f6" bindtap="__e"><text class="data-v-5fbfa8f6">取消</text></view><view data-event-opts="{{[['tap',[['submitFeedback',['$event']]]]]}}" class="btn-primary flex-1 flex center h-14 rounded-2xl shadow-primary-btn data-v-5fbfa8f6" bindtap="__e"><text class="text-white font-bold data-v-5fbfa8f6">提交</text></view></view></view></view></block></view>