  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.page-title.data-v-1cb1d99b {
  display: block;
  font-family: Manrope, sans-serif;
  font-size: 40rpx;
  font-weight: 800;
  color: #191c1e;
  margin-bottom: 8rpx;
  letter-spacing: -1rpx;
}
.page-subtitle.data-v-1cb1d99b {
  display: block;
  font-size: 20rpx;
  color: #424656;
  font-weight: 500;
  letter-spacing: 4rpx;
