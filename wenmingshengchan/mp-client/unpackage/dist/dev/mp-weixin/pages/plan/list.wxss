}
.icon.data-v-1cb1d99b {
  color: #0050cb;
}
.btn-primary.data-v-1cb1d99b {
  background: #0050cb;
  color: #fff;
  box-shadow: 0 8rpx 16rpx rgba(0, 80, 203, 0.2);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 26rpx;
  font-weight: 700;
  height: 64rpx;
  padding: 16rpx 20rpx;
  transition: all 0.3s ease;
}
/* Area Group Header */
