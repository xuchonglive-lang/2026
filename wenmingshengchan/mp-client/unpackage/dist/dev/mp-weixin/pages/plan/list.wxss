/* Status Tabs System */
.tab-system.data-v-1cb1d99b {
  display: flex;
  flex-direction: column;
}
.status-tabs.data-v-1cb1d99b {
  display: flex;
  align-items: flex-end;
  padding: 0;
  margin-bottom: -1px;
}
.tab.data-v-1cb1d99b {
  position: relative;
  padding: 20rpx 48rpx;
  font-size: 28rpx;
  border-radius: 24rpx 24rpx 0 0;
  border: 1px solid rgba(255, 255, 255, 0.6);
  border-bottom: none;
  margin-right: -16rpx;
  text-align: center;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}
.tab.active-tab.data-v-1cb1d99b {
  z-index: 30;
  background: #fff;
  color: #0050cb;
  font-weight: 700;
  box-shadow:
    0 -12rpx 32rpx -8rpx rgba(0, 80, 203, 0.15),
    inset 0 2rpx 0 rgba(255, 255, 255, 1);
}
.tab.glass-tab.data-v-1cb1d99b {
  z-index: 20;
  background: rgba(255, 255, 255, 0.3);
  -webkit-backdrop-filter: blur(12px);
          backdrop-filter: blur(12px);
  color: #64748b;
  font-weight: 500;
  opacity: 0.8;
  border-color: rgba(255, 255, 255, 0.4);
}
.input-label.data-v-1cb1d99b {
  font-size: 24rpx;
  font-weight: 800;
  color: #0050cb;
  letter-spacing: 2rpx;
}
.select-wrapper.data-v-1cb1d99b,
.date-wrapper.data-v-1cb1d99b {
  position: relative;
  background: rgba(255, 255, 255, 0.8);
  border: 1px solid rgba(0, 0, 0, 0.05);
  border-radius: 16rpx;
