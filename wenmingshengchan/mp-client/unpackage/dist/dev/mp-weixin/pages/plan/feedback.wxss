}
.pb-32.data-v-4da7e2fc { padding-bottom: 256rpx;
}
.mb-1.data-v-4da7e2fc { margin-bottom: 8rpx;
}
.mb-2.data-v-4da7e2fc { margin-bottom: 16rpx;
}
.mb-3.data-v-4da7e2fc { margin-bottom: 24rpx;
}
.mb-4.data-v-4da7e2fc { margin-bottom: 32rpx;
