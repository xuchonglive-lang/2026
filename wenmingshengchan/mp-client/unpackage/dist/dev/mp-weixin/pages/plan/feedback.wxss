/* Section Headers */
.section-header.data-v-4da7e2fc {
  display: inline-block;
  border-bottom: 6rpx solid #0066ff;
  padding-bottom: 12rpx;
}
.section-title.data-v-4da7e2fc {
  font-size: 36rpx;
  font-weight: 800;
  color: #0f172a;
  letter-spacing: 2rpx;
}
/* Cards & Containers */
.card-panel.data-v-4da7e2fc {
  background-color: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.03);
}
.feedback-box.data-v-4da7e2fc {
  background-color: #f8fafc;
  border-radius: 24rpx;
}
.executor-box.data-v-4da7e2fc {
  background-color: #f4f8ff;
  border-radius: 48rpx;
}
/* Text Styles */
.label-blue.data-v-4da7e2fc {
  color: #0066ff;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}
.label-grey.data-v-4da7e2fc {
  color: #94a3b8;
  font-size: 22rpx;
  font-weight: 600;
}
.title-main.data-v-4da7e2fc {
  font-size: 40rpx;
  font-weight: 800;
  color: #0f172a;
  line-height: 1.4;
}
.info-text.data-v-4da7e2fc {
  font-size: 28rpx;
  color: #0f172a;
}
.content-text.data-v-4da7e2fc {
  font-size: 28rpx;
  color: #334155;
  line-height: 1.8;
}
.time-text.data-v-4da7e2fc {
  font-size: 24rpx;
  color: #94a3b8;
  font-family: monospace;
}
.bullet-item.data-v-4da7e2fc::before {
  content: '•';
  position: absolute;
  left: 0;
  color: #64748b;
  font-size: 28rpx;
}
/* Avatars & Images */
.avatar-sm.data-v-4da7e2fc {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
}
.avatar-md.data-v-4da7e2fc {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 4rpx solid #ffffff;
}
.avatar-md.no-border.data-v-4da7e2fc {
  border: none;
}
.avatar-more-md.data-v-4da7e2fc {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 4rpx solid #ffffff;
  background-color: #dbeafe;
  margin-left: -24rpx;
  font-size: 24rpx;
}
.avatar-stack.data-v-4da7e2fc {
  margin-right: 8rpx;
}
.img-wrapper.data-v-4da7e2fc {
  aspect-ratio: 16/9;
  border-radius: 16rpx;
  overflow: hidden;
}
.feedback-img.data-v-4da7e2fc {
  width: 100%;
  height: 100%;
}
.img-tag.data-v-4da7e2fc {
  background-color: rgba(0, 0, 0, 0.6);
  color: #ffffff;
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}
/* Buttons */
.status-btn.data-v-4da7e2fc {
  background-color: #0066ff;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  padding: 12rpx 32rpx;
  border-radius: 32rpx;
}
.primary-btn-lg.data-v-4da7e2fc {
  background-color: #0066ff;
  color: #ffffff;
  font-weight: 800;
  font-size: 36rpx;
  height: 112rpx;
  border-radius: 56rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 102, 255, 0.2);
}
.action-footer.data-v-4da7e2fc {
  background: linear-gradient(to top, #f8fafc 60%, rgba(248, 250, 252, 0));
}
/* Editor Toolbar tags */
.tool-tag.data-v-4da7e2fc {
  font-size: 26rpx;
  color: #475569;
  background: #f1f5f9;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}
.tool-tag.data-v-4da7e2fc:active { background: #e2e8f0;
}
.tool-tag.primary.data-v-4da7e2fc {
  color: #0066ff;
  background: #eff6ff;
  font-weight: 600;
}
.divider.data-v-4da7e2fc {
  width: 2rpx;
  height: 32rpx;
  background: #cbd5e1;
  margin: 0 4rpx;
}
.ml-3.data-v-4da7e2fc { margin-left: 24rpx;
}
.mt-4.data-v-4da7e2fc { margin-top: 32rpx;
}
.text-red-500.data-v-4da7e2fc { color: #ef4444;
}
/* sp-editor 外部容器，给足明确的高度，避免微信小程序由于 flex: 1 导致整个盒子计算塌陷高度为 0 */
.editor-container.data-v-4da7e2fc {
  min-height: 540rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  border: 1px solid #e2e8f0;
  display: block;
  overflow: visible;
}

