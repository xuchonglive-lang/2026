.page-container.data-v-4da7e2fc {
  min-height: 100vh;
  box-sizing: border-box;
  font-family: 'Inter', sans-serif;
  background-color: #f8fafc;
}
.dot-bg.data-v-4da7e2fc {
  background-image: radial-gradient(#cbd5e1 2rpx, transparent 2rpx);
  background-size: 32rpx 32rpx;
}
/* Typography & Layout */
.font-bold.data-v-4da7e2fc { font-weight: 700;
}
.text-xs.data-v-4da7e2fc { font-size: 24rpx;
}
.text-xl.data-v-4da7e2fc { font-size: 40rpx;
}
.text-primary.data-v-4da7e2fc { color: #0066ff;
}
.display-block.data-v-4da7e2fc { display: block;
}
.flex.data-v-4da7e2fc { display: flex;
}
.items-center.data-v-4da7e2fc { align-items: center;
}
.justify-between.data-v-4da7e2fc { justify-content: space-between;
}
.center.data-v-4da7e2fc { align-items: center; justify-content: center;
}
.w-full.data-v-4da7e2fc { width: 100%;
}
.grid-2.data-v-4da7e2fc { display: grid; grid-template-columns: 1fr 1fr;
}
.relative.data-v-4da7e2fc { position: relative;
}
.absolute.data-v-4da7e2fc { position: absolute;
}
.fixed.data-v-4da7e2fc { position: fixed;
}
.bottom-0.data-v-4da7e2fc { bottom: 0;
}
.left-0.data-v-4da7e2fc { left: 0;
}
.z-50.data-v-4da7e2fc { z-index: 50;
}
.space-y-1 > view.data-v-4da7e2fc, .space-y-1 > text.data-v-4da7e2fc { margin-bottom: 8rpx;
}
.space-y-1 > view.data-v-4da7e2fc:last-child, .space-y-1 > text.data-v-4da7e2fc:last-child { margin-bottom: 0;
}
.space-y-2 > view.data-v-4da7e2fc, .space-y-2 > text.data-v-4da7e2fc { margin-bottom: 16rpx;
}
.space-y-2 > view.data-v-4da7e2fc:last-child, .space-y-2 > text.data-v-4da7e2fc:last-child { margin-bottom: 0;
}
