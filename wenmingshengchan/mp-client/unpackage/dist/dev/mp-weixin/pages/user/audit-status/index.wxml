<view class="page-audit data-v-f8dd53fc"><view class="grid-floor data-v-f8dd53fc"></view><view class="orb orb-top data-v-f8dd53fc"></view><view class="orb orb-bottom data-v-f8dd53fc"></view><view class="page-header data-v-f8dd53fc"><view class="header-left data-v-f8dd53fc"><text class="header-icon data-v-f8dd53fc">⚙</text><text class="header-title data-v-f8dd53fc">文明生产管理系统</text></view><view class="header-action data-v-f8dd53fc"><text class="header-icon-sm data-v-f8dd53fc">🔔</text></view></view><view class="main-content data-v-f8dd53fc"><view class="center-card-wrap data-v-f8dd53fc"><view class="center-card data-v-f8dd53fc"><block wx:if="{{auditStatus===1}}"><view class="status-icon-wrap data-v-f8dd53fc"><view class="status-circle status-circle-pending data-v-f8dd53fc"><text class="status-emoji data-v-f8dd53fc">⏳</text></view><view class="sync-badge data-v-f8dd53fc"><text class="sync-icon data-v-f8dd53fc">🔄</text></view></view><text class="status-title data-v-f8dd53fc">信息审核中</text><text class="status-desc data-v-f8dd53fc">请耐心等待管理员审核</text></block><block wx:else><block wx:if="{{auditStatus===2}}"><view class="status-icon-wrap data-v-f8dd53fc"><view class="status-circle status-circle-error data-v-f8dd53fc"><text class="status-emoji data-v-f8dd53fc">❌</text></view></view><text class="status-title status-title-error data-v-f8dd53fc">接入请求被驳回</text><text class="status-desc data-v-f8dd53fc">{{"原因: "+(auditReason||'信息不符或终端未授权')}}</text></block><block wx:else><text class="status-syncing data-v-f8dd53fc">SYNCING STATUS...</text></block></block><view class="status-divider data-v-f8dd53fc"></view><view class="status-footer data-v-f8dd53fc"><view class="info-row data-v-f8dd53fc"><text class="info-icon data-v-f8dd53fc">ℹ️</text><text class="info-text data-v-f8dd53fc">如有疑问可联系部门管理员</text></view><block wx:if="{{auditStatus===1}}"><button data-event-opts="{{[['tap',[['checkStatus',['$event']]]]]}}" class="btn-action data-v-f8dd53fc" bindtap="__e"><text class="btn-action-text data-v-f