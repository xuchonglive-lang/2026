.page-audit.data-v-f8dd53fc {
  min-height: 100vh;
  background: linear-gradient(135deg, #f7f9fb 0%, #dae1ff 100%);
  color: #191c1e;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
}
.grid-floor.data-v-f8dd53fc {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  background-image: radial-gradient(circle, rgba(0, 80, 203, 0.05) 1px, transparent 1px);
  background-size: 48rpx 48rpx;
  pointer-events: none;
}
/* Ambient Orbs */
.orb.data-v-f8dd53fc {
  position: fixed;
  border-radius: 50%;
  pointer-events: none;
  z-index: 0;
}
.orb-top.data-v-f8dd53fc {
  top: 10%;
  left: 5%;
  width: 400rpx;
  height: 400rpx;
  background: rgba(0, 80, 203, 0.08);
  -webkit-filter: blur(80px);
          filter: blur(80px);
}
.orb-bottom.data-v-f8dd53fc {
  bottom: 20%;
  right: 5%;
  width: 300rpx;
  height: 300rpx;
  background: rgba(66, 92, 160, 0.1);
  -webkit-filter: blur(60px);
          filter: blur(60px);
}
