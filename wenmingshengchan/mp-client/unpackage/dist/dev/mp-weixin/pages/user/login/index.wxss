/* ====================================================================
   LOGIN PAGE — Industrial Clarity / Precision Lens 1:1
   ==================================================================== */
.page-login.data-v-098d3a3e {
  min-height: 100vh;
  background: linear-gradient(135deg, #f7f9fb 0%, #dae1ff 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  position: relative;
  overflow: hidden;
}
/* Level 0: Grid */
.grid-floor.data-v-098d3a3e {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  background-image: linear-gradient(to right, rgba(0, 80, 203, 0.03) 1px, transparent 1px), linear-gradient(to bottom, rgba(0, 80, 203, 0.03) 1px, transparent 1px);
  background-size: 16rpx 16rpx;
  pointer-events: none;
}
/* Level 2: Login Card */
.login-card.data-v-098d3a3e {
  position: relative;
  z-index: 10;
  width: 100%;
  max-width: 720rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: rgba(255, 255, 255, 0.25);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.4);
  border-radius: 24rpx;
  box-shadow: 0 16rpx 64rpx 0 rgba(0, 80, 203, 0.08);
  padding: 96rpx 80rpx 64rpx;
}
/* Logo */
.logo-box.data-v-098d3a3e {
  width: 192rpx;
  height: 192rpx;
  border-radius: 24rpx;
  background: rgba(224, 227, 229, 0.5);
  border: 1px solid rgba(255, 255, 255, 0.5);
  overflow: hidden;
  margin-bottom: 48rpx;
  box-shadow: inset 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}
.logo-img.data-v-098d3a3e {
  width: 100%;
  height: 100%;
}
/* Title */
.sys-title.data-v-098d3a3e {
  font-family: "Manrope", sans-serif;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.3;
  letter-spacing: 0.05em;
  color: #191c1e;
  text-align: center;
  margin-bottom: 80rpx;
}
/* WeChat Login Button */
.btn-wechat.data-v-098d3a3e {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  padding: 0 48rpx;
  border-radius: 24rpx;
  background-color: #0066ff;
  color: #ffffff;
  border: none;
  margin-bottom: 64rpx;
  box-shadow: inset 0 4rpx 8rpx rgba(255, 255, 255, 0.2), 0 8rpx 20rpx rgba(0, 102, 255, 0.2);
  transition: all 200ms cubic-bezier(0.2, 0.8, 0.2, 1);
}
.btn-wechat.data-v-098d3a3e:active {
  -webkit-transform: scale(0.98);
          transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(0, 102, 255, 0.2);
}
.btn-icon.data-v-098d3a3e {
  font-size: 40rpx;
  margin-right: 16rpx;
}
.btn-text.data-v-098d3a3e {
  font-family: "Inter", sans-serif;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 0.05em;
  color: #ffffff;
}
/* Privacy */
.privacy-text.data-v-098d3a3e {
  font-family: "Inter", sans-serif;
  font-size: 24rpx;
  font-weight: 500;
  color: #424656;
  text-align: center;
  text-decoration: underline;
  text-underline-offset: 6rpx;
  letter-spacing: 0.05em;
  opacity: 0.8;
}
/* uniapp button reset */
button.data-v-098d3a3e::after {
  border: none;
}
