.page-container.data-v-45a50fd2 {
  min-height: 100vh;
  background-color: #f8fafc;
  font-family: "Inter", -apple-system, sans-serif;
  padding-bottom: 240rpx;
}
.main-content.data-v-45a50fd2 {
  padding: 80rpx 40rpx;
  max-width: 1200rpx;
  margin: 0 auto;
}
.header-section.data-v-45a50fd2 {
  margin-bottom: 60rpx;
  padding-left: 10rpx;
}
.header-section .title.data-v-45a50fd2 {
  font-size: 56rpx;
  font-weight: 800;
  color: #0f172a;
  letter-spacing: -0.03em;
  display: block;
  margin-bottom: 12rpx;
}
.header-section .subtitle.data-v-45a50fd2 {
  font-size: 28rpx;
  color: #64748b;
  font-weight: 500;
}
.form-section.data-v-45a50fd2 {
  display: flex;
  flex-direction: column;
  gap: 40rpx;
}
.form-card.data-v-45a50fd2 {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 40rpx;
  box-shadow: 0 10rpx 40rpx -10rpx rgba(0, 0, 0, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.5);
}
.card-title.data-v-45a50fd2 {
  font-size: 26rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.card-title.data-v-45a50fd2::before {
  content: "";
  width: 6rpx;
  height: 24rpx;
  background: #0066ff;
  border-radius: 4rpx;
}
/* uView Input Overrides */
.input-box.data-v-45a50fd2  .u-input__input {
  font-size: 30rpx;
  font-weight: 500;
  color: #0f172a;
}
.input-box.data-v-45a50fd2  .u-input--border {
  border: none !important;
}
.mb-3.data-v-45a50fd2 {
  margin-bottom: 24rpx;
}
.mb-4.data-v-45a50fd2 {
  margin-bottom: 32rpx;
}
/* Editor Styling */
.editor-wrap.data-v-45a50fd2 {
  background-color: #f2f3f5;
  border-radius: 16rpx;
  overflow: hidden;
}
.editor-wrap.data-v-45a50fd2  .wrapper {
  padding: 0 !important;
}
.editor-wrap.data-v-45a50fd2  .toolbar {
  background-color: #f8fafc !important;
  border-top: none !important;
  border-bottom: 1px solid #e2e8f0 !important;
  padding: 10rpx 0 !important;
}
.editor-wrap.data-v-45a50fd2  .container {
  background-color: transparent !important;
  min-height: 300rpx;
}
/* Toggles */
.toggles-card.data-v-45a50fd2 {
  padding: 40rpx !important;
}
.toggle-row.data-v-45a50fd2 {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.toggle-info.data-v-45a50fd2 {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.toggle-info .icon-box.data-v-45a50fd2 {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.toggle-info .icon-box.danger-box.data-v-45a50fd2 {
  background: rgba(239, 68, 68, 0.1);
}
.toggle-info .icon-box.primary-box.data-v-45a50fd2 {
  background: rgba(0, 102, 255, 0.1);
}
.toggle-info .icon-box .danger-icon.data-v-45a50fd2 {
  color: #ef4444;
  font-size: 40rpx;
}
.toggle-info .icon-box .primary-icon.data-v-45a50fd2 {
  color: #0066ff;
  font-size: 40rpx;
}
.toggle-info .toggle-text.data-v-45a50fd2 {
  display: flex;
  flex-direction: column;
}
.toggle-info .toggle-text .main-text.data-v-45a50fd2 {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
}
.toggle-info .toggle-text .sub-text.data-v-45a50fd2 {
  font-size: 22rpx;
  color: #64748b;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  margin-top: 4rpx;
}
.btn-wrap.data-v-45a50fd2 {
  margin-top: 20rpx;
}
.submit-btn.data-v-45a50fd2 {
  width: 100%;
  padding: 36rpx 0;
  background: linear-gradient(135deg, #0066ff 0%, #0044bb 100%);
  color: #ffffff;
  font-family: "Inter", sans-serif;
  font-weight: 700;
  border-radius: 24rpx;
  box-shadow: 0 20rpx 40rpx -12rpx rgba(0, 102, 255, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  border: none;
  line-height: 1;
  font-size: 32rpx;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}
.submit-btn-hover.data-v-45a50fd2 {
  -webkit-transform: translateY(4rpx);
          transform: translateY(4rpx);
  box-shadow: 0 10rpx 20rpx -10rpx rgba(0, 102, 255, 0.4);
}
