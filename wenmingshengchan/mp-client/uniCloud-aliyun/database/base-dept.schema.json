{
  "bsonType": "object",
  "required": ["name", "status"],
  "permission": { "read": "true", "create": "false", "update": "false", "delete": "false" },
  "properties": {
    "_id": { "description": "ID，系统自动生成" },
    "parent_id": { "bsonType": "string", "description": "父级ID，为空时表示顶层公司", "parentKey": "name" },
    "name": { "bsonType": "string", "description": "部门/小组名称" },
    "manager": { "bsonType": "string", "description": "负责人姓名" },
    "sort": { "bsonType": "int", "description": "排序", "defaultValue": 0 },
    "status": { "bsonType": "int", "description": "状态 (1正常/0禁用)", "defaultValue": 1 }
  }
}
