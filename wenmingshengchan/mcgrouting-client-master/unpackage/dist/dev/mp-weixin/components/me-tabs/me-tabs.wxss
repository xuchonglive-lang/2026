}
80% {
        -webkit-transform: translateX(2px);
                transform: translateX(2px)
}
90% {
        -webkit-transform: translateX(-1px);
                transform: translateX(-1px)
}
}
@-webkit-keyframes slide-left {
0% {
        opacity: 0;
        -webkit-transform: translateX(-100%);
