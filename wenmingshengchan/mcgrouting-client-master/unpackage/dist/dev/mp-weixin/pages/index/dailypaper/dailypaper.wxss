/* 布局 */
.center {
  display: flex;
  align-items: center;
  justify-content: center;
}
.row {
  display: flex;
  flex-direction: row;
}
.column {
  display: flex;
  flex-direction: column;
}
.space-between {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
}
.one {
  flex: 1;
}
/* input */
.placeholder {
  color: #999 !important;
}
/* 隐藏滚动条的问题,但依旧具备可以滚动的功能 */
/* 解决小程序和app  */
.noScorll ::-webkit-scrollbar {
  display: none;
}
/* 解决 H5 的问题 */
.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-line-clamp: 2;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  white-space: normal;
}
/* 蒙层 */
.mask {
  z-index: 99;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.7);
}
