<view class="cu-custom" style="{{('height:'+CustomBar+'px; z-index:2000; position: '+isFixed+';')}}" hidden="{{isNav}}"><view class="{{['cu-bar fixed '+(bgImage!=''?'none-bg text-white bg-img':'')+' '+bgColor]}}" style="{{('padding-right:0rpx;height:'+CustomBar+'px;padding-top:'+StatusBar+'px;'+(bgImage?'background-image:url('+bgImage+')':''))}}"><image class="gif-black response" style="height:100rpx;position:absolute;bottom:0rpx;" src="https://vkceyugu.cdn.bspapp.com/VKCEYUGU-0b4222a2-027f-48c2-a49b-879fb094a2b1/b144e1b9-bfe3-4ef1-95f4-dbc9c41f8d70.gif" mode="scaleToFill"></image><block wx:if="{{isBack}}"><view data-event-opts="{{[['tap',[['BackPage',['$event']]]]]}}" class="action" bindtap="__e"><text class="cuIcon-back"></text><slot name="backText"></slot></view></block><block wx:if="{{isCustom}}"><view class="action border-custom" style="{{('width:'+Custom.width+'px;height:'+Custom.height+'px;margin-left:calc(750rpx - '+Custom.right+'px)')}}"><text data-event-opts="{{[['tap',[['BackPage',['$event']]]]]}}" class="cuIcon-back" bindtap="__e"></text><text data-event-opts="{{[['tap',[['toHome',['$event']]]]]}}" class="cuIcon-homefill" bindtap="__e"></text></view></block><view class="content" style="{{('top:'+StatusBar+'px')}}"><slot name="content"></slot></view><slot name="right"></slot></view></view>